# Base URL the frontend uses to call the backend API.
# Leave as /api during local development - vite.config.js proxies /api to
# http://localhost:8080 so the browser never needs CORS for the dev server.
# In production, point this at your deployed backend, e.g.:
# VITE_API_BASE_URL=https://api.sociomantrias.com/api
VITE_API_BASE_URL=/api

# Google Sign-In "Continue with Google" button on the student login/signup
# pages. Leave blank to hide the button entirely. Get this from Google Cloud
# Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web
# application) - see backend/README.md for the full walkthrough. This value
# is public/safe to expose in frontend code (it's a client ID, not a secret).
VITE_GOOGLE_CLIENT_ID=

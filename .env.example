# Copy to .env and fill in real values before running `docker compose up`.

DB_PASSWORD=chetan@7020
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-characters
CORS_ORIGINS=http://localhost
FRONTEND_URL=http://localhost

# Password reset email delivery - set MAIL_ENABLED=true and fill in real
# SMTP creds to actually email reset links instead of the dev-mode fallback.
# See backend/README.md for a Gmail App Password walkthrough.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=SocioMantra IAS Academy <no-reply@sociomantrias.com>
EXPOSE_RESET_TOKEN=false

# "Continue with Google" - leave blank to disable. See backend/README.md.
GOOGLE_CLIENT_ID=
